@model PetAppointmentReservationSystem.Models.ForgotPasswordVM
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-wrap">
    <div class="form-card">
        <h2>Reset your password</h2>
        <p class="form-card-sub">Enter your email and we'll send you a reset link.</p>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="field-validation"></span>
            </div>

            <button type="submit" class="btn btn-pc-accent btn-block">Send Reset Link</button>
            <p class="form-switch"><a asp-controller="Account" asp-action="Login">Back to Login</a></p>
        </form>
    </div>
</div>