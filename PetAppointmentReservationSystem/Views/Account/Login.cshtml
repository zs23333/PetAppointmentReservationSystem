@model PetAppointmentReservationSystem.Models.LoginVM
@{
    ViewData["Title"] = "Login";
}

<div class="auth-wrap">
    <div class="form-card">
        <div class="form-card-icon">🐾</div>
        <h2>Welcome back</h2>
        <p class="form-card-sub">Log in to manage your appointments.</p>

        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Username"></label>
                <input asp-for="Username" class="form-control" placeholder="e.g. jane_doe" />
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" />
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Password" class="field-validation"></span>
            </div>

            <div class="form-group form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-pc-accent btn-block">Login</button>
            <p class="form-switch">Don't have an account? <a asp-controller="Account" asp-action="Register">Register</a></p>
        </form>
    </div>
</div>