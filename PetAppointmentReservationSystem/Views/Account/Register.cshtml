@model PetAppointmentReservationSystem.Models.RegisterVM
@{
    ViewData["Title"] = "Register";
}

<div class="auth-wrap">
    <div class="form-card">
        <div class="form-card-icon">🐾</div>
        <h2>Create your account</h2>
        <p class="form-card-sub">Join PetConnect as a pet owner or staff member.</p>

        <form asp-controller="Account" asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" placeholder="Jane Doe" />
                <span asp-validation-for="Name" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Username"></label>
                <input asp-for="Username" class="form-control" placeholder="jane_doe" />
                <span asp-validation-for="Username" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="field-validation"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="field-validation"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Role"></label>
                <select asp-for="Role" class="form-control">
                    <option value="Customer">Customer (pet owner)</option>
                    <option value="Staff">Staff</option>
                </select>
            </div>

            <button type="submit" class="btn btn-pc-accent btn-block">Create Account</button>
            <p class="form-switch">Already have an account? <a asp-controller="Account" asp-action="Login">Login</a></p>
        </form>
    </div>
</div>