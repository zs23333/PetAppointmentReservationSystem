@model PetAppointmentReservationSystem.Models.ResetPasswordVM
@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-wrap">
    <div class="form-card">
        <h2>Choose a new password</h2>

        <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword" class="form-control" />
                <span asp-validation-for="NewPassword" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="field-validation"></span>
            </div>

            <button type="submit" class="btn btn-pc-accent btn-block">Reset Password</button>
        </form>
    </div>
</div>