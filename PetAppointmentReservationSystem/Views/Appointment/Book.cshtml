@model PetAppointmentReservationSystem.Models.AppointmentVM
@{
    ViewData["Title"] = "Book Appointment";
}

<div class="form-card form-card-wide">
    <h2>Book an Appointment</h2>
    <p class="form-card-sub">Fill in the details below to schedule a visit.</p>

    <form asp-controller="Appointment" asp-action="Book" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-row form-row-3">
            <div class="form-group">
                <label asp-for="PetName"></label>
                <input asp-for="PetName" class="form-control" placeholder="e.g. Toby" />
                <span asp-validation-for="PetName" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="OwnerName"></label>
                <input asp-for="OwnerName" class="form-control" placeholder="e.g. James Lee" />
                <span asp-validation-for="OwnerName" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="StaffName"></label>
                <input asp-for="StaffName" class="form-control" placeholder="e.g. Dr. Alice Tan" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="ServiceName"></label>
                <input asp-for="ServiceName" class="form-control" placeholder="e.g. Grooming" />
                <span asp-validation-for="ServiceName" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="DurationMinutes"></label>
                <input asp-for="DurationMinutes" class="form-control" />
            </div>
        </div>

        <input asp-for="ServiceId" type="hidden" />

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Date"></label>
                <input asp-for="Date" class="form-control" type="datetime-local" />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Confirm Booking</button>
            <a class="btn btn-ghost" asp-controller="Appointment" asp-action="List">Cancel</a>
        </div>
    </form>
</div>