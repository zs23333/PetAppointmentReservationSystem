@model PetAppointmentReservationSystem.Models.Appointment
@{
    ViewData["Title"] = "Book Appointment";
}

<div class="form-card form-card-wide">
    <h2>Book an Appointment</h2>
    <p class="form-card-sub">Choose a registered pet, or register a new one with a photo right here.</p>

    <form asp-controller="Appointment" asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="PetId">Your Pet</label>
                <select asp-for="PetId" asp-items="ViewBag.PetList" class="form-control" id="petSelect">
                    <option value="0">-- Register a new pet below --</option>
                </select>
            </div>
        </div>

        <div id="newPetFields" class="pc-inline-panel">
            <p class="muted">New pet details (photo required)</p>
            <div class="form-row form-row-3">
                <div class="form-group">
                    <label>Pet Name</label>
                    <input type="text" name="newPetName" class="form-control" placeholder="e.g. Toby" />
                </div>
                <div class="form-group">
                    <label>Species</label>
                    <input type="text" name="newPetSpecies" class="form-control" placeholder="e.g. Dog" />
                </div>
                <div class="form-group">
                    <label>Breed</label>
                    <input type="text" name="newPetBreed" class="form-control" placeholder="e.g. Poodle" />
                </div>
            </div>
            <div class="form-group">
                <label for="newPetPhoto">Photo (JPG/PNG, max 5MB) <span class="text-danger">*</span></label>
                <input type="file" name="newPetPhoto" id="newPetPhoto" class="form-control" accept=".jpg,.jpeg,.png" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Service"></label>
                <select asp-for="Service" asp-items="ViewBag.ServiceList" class="form-control">
                    <option value="">-- Select a service --</option>
                </select>
                <span asp-validation-for="Service" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="StaffId">Staff Member</label>
                <select asp-for="StaffId" asp-items="ViewBag.StaffList" class="form-control">
                    <option value="">-- Select staff --</option>
                </select>
                <span asp-validation-for="StaffId" class="field-validation"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Date"></label>
                <input asp-for="Date" class="form-control" type="datetime-local" />
                <span asp-validation-for="Date" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="DurationMinutes"></label>
                <input asp-for="DurationMinutes" class="form-control" />
                <span asp-validation-for="DurationMinutes" class="field-validation"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-pc-accent">Confirm Booking</button>
            <a class="btn btn-ghost" asp-controller="Appointment" asp-action="List">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Show/hide the inline "new pet" fields depending on the dropdown selection.
        const petSelect = document.getElementById('petSelect');
        const newPetFields = document.getElementById('newPetFields');

        function toggleNewPetFields() {
            newPetFields.style.display = petSelect.value === '0' ? 'block' : 'none';
        }

        petSelect.addEventListener('change', toggleNewPetFields);
        toggleNewPetFields();
    </script>
}