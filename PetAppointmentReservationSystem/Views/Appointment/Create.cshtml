@model PetAppointmentReservationSystem.Models.Appointment
@{
    ViewData["Title"] = "Book Appointment";
}

<div class="form-card form-card-wide">
    <h2>Book an Appointment</h2>
    <p class="form-card-sub">Choose a registered pet, or enter a new pet's name to add it automatically.</p>

    <form asp-controller="Appointment" asp-action="Create" method="post" novalidate>
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="PetId">Your Pet</label>
                <select asp-for="PetId" asp-items="ViewBag.PetList" class="form-control">
                    <option value="0">-- Select a registered pet --</option>
                </select>
            </div>

            <div class="form-group">
                <label>Or Register a New Pet</label>
                <input type="text" name="newPetName" class="form-control" placeholder="New pet's name (optional)" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>New Pet Species</label>
                <input type="text" name="newPetSpecies" class="form-control" placeholder="e.g. Dog (optional)" />
            </div>
            <div class="form-group">
                <label>New Pet Breed</label>
                <input type="text" name="newPetBreed" class="form-control" placeholder="e.g. Poodle (optional)" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Service"></label>
                <select asp-for="Service" asp-items="ViewBag.ServiceList" class="form-control">
                    <option value="">-- Select a service --</option>
                </select>
                <span asp-validation-for="Service" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="StaffId">Staff Member</label>
                <select asp-for="StaffId" asp-items="ViewBag.StaffList" class="form-control">
                    <option value="">-- Select staff --</option>
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Date"></label>
                <input asp-for="Date" class="form-control" type="datetime-local" />
            </div>

            <div class="form-group">
                <label asp-for="DurationMinutes"></label>
                <input asp-for="DurationMinutes" class="form-control" />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-pc-accent">Confirm Booking</button>
            <a class="btn btn-ghost" asp-controller="Appointment" asp-action="List">Cancel</a>
        </div>
    </form>
</div>