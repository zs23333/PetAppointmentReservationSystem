@model IEnumerable<PetAppointmentReservationSystem.Models.Appointment>
@{
    ViewData["Title"] = "My Appointments";
}

<div class="calendar-header">
    <div>
        <h2>Your Appointment Book</h2>
        <p class="muted">@Model.Count() appointments booked</p>
    </div>
    <a class="btn btn-pc-accent" asp-controller="Appointment" asp-action="Create">+ New Appointment</a>
</div>

<div class="table-responsive pc-table-wrap">
    <table class="table table-dark table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Pet</th>
                <th>Service</th>
                <th>Staff</th>
                <th>Date &amp; Time</th>
                <th>Duration</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appt in Model)
            {
                <tr>
                    <td><strong>@appt.Pet?.Name</strong></td>
                    <td>@appt.Service</td>
                    <td>@(appt.Staff?.Name ?? "Unassigned")</td>
                    <td>@appt.Date.ToString("MMM d, yyyy h:mm tt")</td>
                    <td>@appt.DurationMinutes min</td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No appointments booked yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>