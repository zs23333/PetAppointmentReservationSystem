@model IEnumerable<PetAppointmentReservationSystem.Models.Appointment>
@{
    ViewData["Title"] = "My Appointments";
}

<div class="calendar-header">
    <div>
        <h2>Your Appointment Book</h2>
        <p class="muted">@Model.Count() appointments booked</p>
    </div>
    <a class="btn btn-pc-accent" asp-controller="Appointment" asp-action="Create">+ New Appointment</a>
</div>

<div class="form-group" style="width:100%; max-width:360px;">
    <input type="text" id="searchBox" class="form-control" placeholder="Search by pet, service, or staff..." />
</div>

<div class="table-responsive pc-table-wrap">
    <table class="table table-dark table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Pet</th>
                <th>Service</th>
                <th>Staff</th>
                <th>Date &amp; Time</th>
                <th>Duration</th>
            </tr>
        </thead>
        <tbody id="appointmentRows">
            @await Html.PartialAsync("_AppointmentRows", Model)
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        const searchBox = document.getElementById('searchBox');
        let debounceTimer;

        searchBox.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(function() {
                fetch('/Appointment/Search?q=' + encodeURIComponent(searchBox.value))
                    .then(res => res.text())
                    .then(html => { document.getElementById('appointmentRows').innerHTML = html; });
            }, 300);
        });
    </script>
}