<div id="appointmentModal" class="modal-overlay hidden">
    <div class="modal-box">
        <button class="modal-close" onclick="closeAppointmentModal()" aria-label="Close">&times;</button>

        <div class="modal-header">
            <div class="modal-pet-avatar">🐾</div>
            <div>
                <h3 id="modalPetName">Pet Name</h3>
                <span id="modalService" class="modal-service-tag"></span>
            </div>
        </div>

        <dl class="modal-details">
            <dt>Owner</dt>
            <dd id="modalOwner"></dd>

            <dt>Type</dt>
            <dd id="modalType"></dd>

            <dt>Staff</dt>
            <dd id="modalStaff"></dd>

            <dt>Start Time</dt>
            <dd id="modalStart"></dd>

            <dt>Duration</dt>
            <dd id="modalDuration"></dd>

            <dt>Phone</dt>
            <dd id="modalPhone"></dd>

            <dt>Email</dt>
            <dd id="modalEmail"></dd>

            <dt>Notes</dt>
            <dd id="modalNotes"></dd>
        </dl>
    </div>
</div>