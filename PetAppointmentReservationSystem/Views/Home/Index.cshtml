@{
    ViewData["Title"] = "Home";
}

<section class="hero-center">
    <span class="eyebrow">Pet Appointment Reservation System</span>
    <h1>Welcome to PetConnect</h1>
    <p>Book grooming, checkups, and vaccinations for your pet — and keep every staff member's schedule in one calm, tidy calendar.</p>
</section>

<section class="quick-links-grid">
    @if (ViewBag.Username == null)
    {
        <a class="quick-card" asp-controller="Account" asp-action="Login">
            <h3>Login</h3>
            <p>Access your PetConnect account.</p>
            <span class="quick-arrow">Go to Login →</span>
        </a>

        <a class="quick-card" asp-controller="Account" asp-action="Register">
            <h3>Register</h3>
            <p>Create a new owner or staff account.</p>
            <span class="quick-arrow">Go to Register →</span>
        </a>
    }

    <a class="quick-card featured" asp-controller="Appointment" asp-action="Create">
        <h3>Book Appointment</h3>
        <p>Schedule a new visit for your pet.</p>
        <span class="quick-arrow">Book Now →</span>
    </a>

    <a class="quick-card" asp-controller="Appointment" asp-action="List">
        <h3>Appointment Book</h3>
        <p>View, edit, or cancel scheduled visits.</p>
        <span class="quick-arrow">Open Calendar →</span>
    </a>

    <a class="quick-card" asp-controller="Pet" asp-action="Index">
        <h3>My Pets</h3>
        <p>Manage your registered pets and photos.</p>
        <span class="quick-arrow">View Pets →</span>
    </a>
</section>