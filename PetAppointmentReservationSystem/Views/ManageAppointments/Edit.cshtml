@model PetAppointmentReservationSystem.Models.Appointment
@{
    ViewData["Title"] = "Edit Appointment";
}

<div class="form-card form-card-wide">
    <h2>Edit Appointment</h2>

    <form asp-controller="ManageAppointments" asp-action="Edit" asp-route-id="@Model.AppointmentId" method="post" novalidate>
        <input type="hidden" asp-for="AppointmentId" />
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="PetId">Pet</label>
                <select asp-for="PetId" asp-items="ViewBag.PetList" class="form-control"></select>
            </div>

            <div class="form-group">
                <label asp-for="Service"></label>
                <select asp-for="Service" asp-items="ViewBag.ServiceList" class="form-control"></select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="StaffId">Staff Member</label>
                <select asp-for="StaffId" asp-items="ViewBag.StaffList" class="form-control"></select>
            </div>

            <div class="form-group">
                <label asp-for="DurationMinutes"></label>
                <input asp-for="DurationMinutes" class="form-control" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Date"></label>
                <input asp-for="Date" class="form-control" type="datetime-local" />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-pc-accent">Save Changes</button>
            <a class="btn btn-ghost" asp-controller="ManageAppointments" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>