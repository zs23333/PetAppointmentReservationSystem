@model PetAppointmentReservationSystem.Models.Pet
@{
    ViewData["Title"] = Model.Name;
}

<div class="form-card form-card-wide">
    <h2>@Model.Name</h2>
    <p class="muted">
        @Model.Species@(string.IsNullOrEmpty(Model.Breed) ? "" : $" · {Model.Breed}")
    </p>
    <p class="muted">Owner: @(Model.Owner?.Username ?? "Unknown")</p>

    <div class="pet-photo-gallery">
        <img src="@Model.PhotoPath" class="pet-photo-preview" alt="@Model.Name (main photo)" />

        @foreach (var photo in Model.Photos)
        {
            <img src="@photo.PhotoPath" class="pet-photo-preview" alt="@Model.Name" />
        }
    </div>

    <a class="btn btn-ghost mt-3" asp-controller="ManageAppointments" asp-action="Index">Back to Appointments</a>
</div>