@model PetAppointmentReservationSystem.Models.Pet
@{
    ViewData["Title"] = "Add Pet";
}

<div class="form-card form-card-wide">
    <h2>Add a Pet</h2>
    <p class="form-card-sub">A photo is required to register a pet.</p>

    <form asp-controller="Pet" asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Toby" />
                <span asp-validation-for="Name" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Species"></label>
                <input asp-for="Species" class="form-control" placeholder="e.g. Dog" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Breed"></label>
                <input asp-for="Breed" class="form-control" placeholder="e.g. Golden Retriever" />
            </div>

            <div class="form-group">
                <label for="photo">Photo <span class="text-danger">*</span></label>
                <input type="file" name="photo" id="photo" class="form-control" accept="image/*" required />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-pc-accent">Save Pet</button>
            <a class="btn btn-ghost" asp-controller="Pet" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>