@model PetAppointmentReservationSystem.Models.Pet
@{
    ViewData["Title"] = "Edit Pet";
}

<div class="form-card form-card-wide">
    <h2>Edit Pet</h2>

    @if (!string.IsNullOrEmpty(Model.PhotoPath))
    {
        <img src="@Model.PhotoPath" alt="@Model.Name" class="pet-photo-preview" />
    }

    <form asp-controller="Pet" asp-action="Edit" asp-route-id="@Model.PetId" method="post" enctype="multipart/form-data" novalidate>
        <input type="hidden" asp-for="PetId" />
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Species"></label>
                <input asp-for="Species" class="form-control" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Breed"></label>
                <input asp-for="Breed" class="form-control" />
            </div>

            <div class="form-group">
                <label for="photo">Replace Photo</label>
                <input type="file" name="photo" id="photo" class="form-control" accept="image/*" />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-pc-accent">Save Changes</button>
            <a class="btn btn-ghost" asp-controller="Pet" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>