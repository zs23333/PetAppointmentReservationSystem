@model PetAppointmentReservationSystem.Models.Service
@{
    ViewData["Title"] = "Edit Service";
}

<div class="form-card form-card-wide">
    <h2>Edit Service</h2>

    @if (!string.IsNullOrEmpty(Model.PhotoPath))
    {
        <img src="@Model.PhotoPath" alt="@Model.Name" class="pet-photo-preview" />
    }

    <form asp-controller="Services" asp-action="Edit" asp-route-id="@Model.ServiceId" method="post" enctype="multipart/form-data" novalidate>
        <input type="hidden" asp-for="ServiceId" />
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="field-validation"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="DurationMinutes"></label>
                <input asp-for="DurationMinutes" class="form-control" />
            </div>

            <div class="form-group">
                <label for="photo">Replace Photo</label>
                <input type="file" name="photo" id="photo" class="form-control" accept=".jpg,.jpeg,.png" />
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-pc-accent">Save Changes</button>
            <a class="btn btn-ghost" asp-controller="Services" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>