<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetConnect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="app-shell">
        <button id="sidebarToggle" class="sidebar-toggle" aria-label="Toggle menu">
            <svg viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
        </button>

        <div id="sidebarOverlay" class="sidebar-overlay"></div>

        <aside id="sidebar" class="sidebar">
            <div class="sidebar-brand">
                <span class="brand-mark">🐾</span>
                <span>PetConnect</span>
            </div>

            @{
                var ctrl = ViewContext.RouteData.Values["Controller"]?.ToString();
                var section = ViewContext.RouteData.Values["Action"]?.ToString() == "ComingSoon"
                    ? ViewData["Section"]?.ToString()
                    : null;
            }

            <nav class="sidebar-nav">
                <a asp-controller="Home" asp-action="Index" class="@(ctrl == "Home" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5" /><path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9" /></svg>
                    <span>Home</span>
                </a>
                <a asp-controller="Info" asp-action="ComingSoon" asp-route-section="Services" class="@(section == "Services" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M8 2v4M16 2v4M3 10h18" /></svg>
                    <span>Services</span>
                </a>
                <a asp-controller="Appointment" asp-action="List" class="@(ctrl == "Appointment" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    <span>Bookings</span>
                </a>
                <a asp-controller="Info" asp-action="ComingSoon" asp-route-section="Availability" class="@(section == "Availability" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
                    <span>Availability</span>
                </a>
                <a asp-controller="Info" asp-action="ComingSoon" asp-route-section="Contacts" class="@(section == "Contacts" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.4 2.1L8 10a16 16 0 0 0 6 6l1.3-1.4a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z" /></svg>
                    <span>Contacts</span>
                </a>
                <a asp-controller="Appointment" asp-action="List" class="@(ctrl == "Appointment" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2" /><path d="M3 9h18M8 2v4M16 2v4" /></svg>
                    <span>Calendar</span>
                </a>
                <a asp-controller="Info" asp-action="ComingSoon" asp-route-section="Settings" class="@(section == "Settings" ? "active" : "")">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z" /></svg>
                    <span>Settings</span>
                </a>
            </nav>

            <div class="sidebar-foot">
                <div class="avatar-chip">
                    <div class="avatar-circle">PC</div>
                    <div class="avatar-text">
                        <strong>Guest User</strong>
                        <span>Not signed in</span>
                    </div>
                </div>
            </div>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <div class="topbar-left">
                    <h1 class="topbar-title">@ViewData["Title"]</h1>
                    @if (ctrl == "Appointment")
                    {
                        <div class="pill-switcher" role="group" aria-label="Calendar view range">
                            <button type="button" class="pill active" data-range="today">Today</button>
                            <button type="button" class="pill" data-range="day">Day</button>
                            <button type="button" class="pill" data-range="week">Week</button>
                        </div>
                    }
                </div>
                <div class="topbar-actions">
                    <a class="btn btn-ghost" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Register</a>
                </div>
            </header>

            <main class="content">
                @if (TempData["Message"] != null)
                {
                    <div class="alert-banner">
                        <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
                        <span>@TempData["Message"]</span>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/appointments.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>