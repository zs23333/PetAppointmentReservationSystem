<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetConnect</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    @{
        var ctrl = ViewContext.RouteData.Values["Controller"]?.ToString();
        var section = ViewContext.RouteData.Values["Action"]?.ToString() == "ComingSoon"
            ? ViewData["Section"]?.ToString()
            : null;
    }

    <div class="app-shell">
        <button id="sidebarToggle" class="sidebar-toggle" aria-label="Toggle menu">
            <span></span><span></span><span></span>
        </button>

        <div id="sidebarOverlay" class="sidebar-overlay"></div>

        <aside id="sidebar" class="pc-sidebar">
            <div class="pc-brand">
                <span class="brand-mark">🐾</span> PetConnect
            </div>

            <nav class="pc-nav">
                <a class="nav-link @(ctrl == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                <a class="nav-link @(section == "Services" ? "active" : "")" asp-controller="Info" asp-action="ComingSoon" asp-route-section="Services">Services</a>
                <a class="nav-link @(ctrl == "Appointment" ? "active" : "")" asp-controller="Appointment" asp-action="List">Bookings</a>
                <a class="nav-link @(ctrl == "Pet" ? "active" : "")" asp-controller="Pet" asp-action="Index">Pets</a>
                <a class="nav-link @(section == "Availability" ? "active" : "")" asp-controller="Info" asp-action="ComingSoon" asp-route-section="Availability">Availability</a>
                <a class="nav-link @(section == "Contacts" ? "active" : "")" asp-controller="Info" asp-action="ComingSoon" asp-route-section="Contacts">Contacts</a>
                <a class="nav-link @(section == "Settings" ? "active" : "")" asp-controller="Info" asp-action="ComingSoon" asp-route-section="Settings">Settings</a>
            </nav>

            <div class="pc-sidebar-foot">
                @if (Context.Session.GetString("Username") != null)
                {
                    <div class="d-flex align-items-center gap-2">
                        <div class="avatar-circle">
                            @(Context.Session.GetString("Username").Substring(0, Math.Min(2, Context.Session.GetString("Username").Length)).ToUpper())
                        </div>
                        <div class="avatar-text">
                            <strong>@Context.Session.GetString("Username")</strong>
                            <span>@Context.Session.GetString("Role")</span>
                        </div>
                    </div>
                    <a class="btn btn-outline-light btn-sm w-100 mt-2" asp-controller="Account" asp-action="Logout">Logout</a>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2">
                        <div class="avatar-circle">PC</div>
                        <div class="avatar-text">
                            <strong>Guest User</strong>
                            <span>Not signed in</span>
                        </div>
                    </div>
                }
            </div>
        </aside>

        <div class="pc-main">
            <header class="pc-topbar d-flex align-items-center justify-content-between">
                <h1 class="pc-topbar-title">@ViewData["Title"]</h1>
                <div class="d-flex gap-2">
                    @if (Context.Session.GetString("Username") == null)
                    {
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="btn btn-pc-accent btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                    }
                </div>
            </header>

            <main class="pc-content">
                @if (TempData["Message"] != null)
                {
                    <div class="alert-banner">
                        <span>@TempData["Message"]</span>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>